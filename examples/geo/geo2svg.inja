<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width|default(800) }} {{ height|default(600) }}" width="{{ width|default(800) }}" height="{{ height|default(600) }}">
  <rect width="100%" height="100%" fill="#ffffff"/>

  {# FeatureCollection #}
  {% if type == "FeatureCollection" %}
    {% for feature in features %}
      {% set geom = feature.geometry %}
      {% if geom.type == "Point" %}
        <circle cx="{{ geom.coordinates.0 }}" cy="{{ geom.coordinates.1 }}" r="5" fill="{{ fill_color|default("#3498db") }}"/>
      {% else if geom.type == "LineString" %}
        <polyline points="{% for coord in geom.coordinates %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="none" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("2") }}"/>
      {% else if geom.type == "Polygon" %}
        <polygon points="{% for coord in geom.coordinates.0 %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="{{ fill_color|default("#3498db") }}" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("1.5") }}" fill-opacity="0.7"/>
      {% else if geom.type == "MultiPoint" %}
        {% for point in geom.coordinates %}
          <circle cx="{{ point.0 }}" cy="{{ point.1 }}" r="4" fill="{{ fill_color|default("#3498db") }}"/>
        {% endfor %}
      {% else if geom.type == "MultiLineString" %}
        {% for line in geom.coordinates %}
          <polyline points="{% for coord in line %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="none" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("2") }}"/>
        {% endfor %}
      {% else if geom.type == "MultiPolygon" %}
        {% for polygon in geom.coordinates %}
          <polygon points="{% for coord in polygon.0 %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="{{ fill_color|default("#3498db") }}" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("1.5") }}" fill-opacity="0.7"/>
        {% endfor %}
      {% endif %}
    {% endfor %}

  {# Single Feature #}
  {% else if geojson.type == "Feature" %}
    {% set geom = geojson.geometry %}
    {% if geom.type == "Point" %}
      <circle cx="{{ geom.coordinates.0 }}" cy="{{ geom.coordinates.1 }}" r="5" fill="{{ fill_color|default("#3498db") }}"/>
    {% else if geom.type == "LineString" %}
      <polyline points="{% for coord in geom.coordinates %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="none" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("2") }}"/>
    {% else if geom.type == "Polygon" %}
      <polygon points="{% for coord in geom.coordinates.0 %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="{{ fill_color|default("#3498db") }}" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("1.5") }}" fill-opacity="0.7"/>
    {% endif %}

  {# Direct Geometry #}
  {% else if geojson.type == "Point" %}
    <circle cx="{{ geojson.coordinates.0 }}" cy="{{ geojson.coordinates.1 }}" r="5" fill="{{ fill_color|default("#3498db") }}"/>
  {% else if geojson.type == "LineString" %}
    <polyline points="{% for coord in geojson.coordinates %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="none" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("2") }}"/>
  {% else if geojson.type == "Polygon" %}
    <polygon points="{% for coord in geojson.coordinates.0 %}{% if not loop.is_first %},{% endif %}{{ coord.0 }},{{ coord.1 }}{% endfor %}" fill="{{ fill_color|default("#3498db") }}" stroke="{{ stroke_color|default("#2c3e50") }}" stroke-width="{{ stroke_width|default("1.5") }}" fill-opacity="0.7"/>
  {% endif %}
</svg>