{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "store_name": {
      "type": "string",
      "description": "Store Name"
    },
    "announcement_bar": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": ["text", "visible"],
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "subheadline": {
          "type": "string"
        },
        "cta": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": ["text", "href"],
          "additionalProperties": false
        },
        "image_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["headline", "subheadline", "cta", "image_url"],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["benefits", "product_grid", "reviews", "blog_posts"]
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "icon": { "type": "string" },
                    "title": { "type": "string" },
                    "desc": { "type": "string" }
                  },
                  "required": ["icon", "title", "desc"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "user": { "type": "string" },
                    "stars": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "comment": { "type": "string" },
                    "verified": { "type": "boolean" }
                  },
                  "required": ["user", "stars", "comment", "verified"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "date": { "type": "string" },
                    "excerpt": { "type": "string" },
                    "link": { "type": "string" }
                  },
                  "required": ["title", "date", "excerpt", "link"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "price": { "type": "number", "minimum": 0 },
                "old_price": { "type": ["number", "null"], "minimum": 0 },
                "badge": { "type": "string" },
                "image": { "type": "string", "format": "uri" },
                "description": { "type": "string" },
                "rating": { "type": "number", "minimum": 0, "maximum": 5 },
                "reviews": { "type": "integer", "minimum": 0 }
              },
              "required": ["id", "name", "price", "image", "description", "rating", "reviews"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "type"],
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "product_grid" } }
            },
            "then": {
              "required": ["products"]
            }
          },
          {
            "if": {
              "properties": { "type": { "enum": ["benefits", "reviews", "blog_posts"] } }
            },
            "then": {
              "required": ["items"]
            }
          },
          {
            "if": {
              "properties": { "type": { "enum": ["benefits", "product_grid", "reviews", "blog_posts"] } }
            },
            "then": {
              "required": ["title"]
            }
          }
        ]
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "newsletter_title": {
          "type": "string"
        },
        "accepted_payments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["visa", "mastercard", "paypal", "apple-pay", "amex", "google-pay"]
          }
        },
        "quick_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "href": { "type": "string" }
            },
            "required": ["name", "href"],
            "additionalProperties": false
          }
        },
        "social_media": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["facebook", "instagram", "twitter", "tiktok", "youtube", "linkedin", "pinterest"]
          }
        }
      },
      "required": ["newsletter_title", "accepted_payments", "quick_links", "social_media"],
      "additionalProperties": false
    }
  },
  "required": ["store_name", "announcement_bar", "hero", "sections", "footer"],
  "additionalProperties": false
}